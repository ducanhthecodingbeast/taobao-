# ---------------------------------------------------------------------------------------
# Ignore the big, regenerable things; TRACK the small deliverables.
#
# Measured sizes in this repo:
#   artifacts/data    4.8 GB   (dense arrays, joined parquet -- regenerable via the CLI)
#   artifacts/models  230 MB   (checkpoints + demo artifact -- regenerable by training)
#   artifacts/stats    52 KB   } 916 KB total: these ARE the portfolio deliverables
#   artifacts/bench    32 KB   } (measured results), so they are tracked deliberately
#   artifacts/figures 792 KB   }
#   artifacts/reports  40 KB   }
# ---------------------------------------------------------------------------------------

# --- secrets / local config -------------------------------------------------------------
.env
.env.*
!.env.example

# --- python -----------------------------------------------------------------------------
# .venv is a real directory in the main checkout, but a SYMLINK inside git worktrees.
# NOTE: gitignore only treats '#' as a comment at the START of a line -- an inline comment
# becomes part of the pattern -- so both forms are listed on their own lines.
.venv/
.venv
venv/
venv
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- large datasets (never commit data) -------------------------------------------------
UserBehavior.csv.zip
*.csv.zip
*.zip
*.parquet
!tests/**/*.parquet
/data/

# --- regenerable heavy artifacts --------------------------------------------------------
# These are directories INSIDE the tracked artifacts/ tree. In a git worktree they appear as
# symlinks (pointing at the main checkout) so the multi-GB data is not duplicated -- and those
# links must not be committed, or a worktree would try to add a symlink as a real path.
artifacts/data/
artifacts/models/
artifacts/logs/
artifacts/data
artifacts/models
artifacts/logs
*.npy
*.npz
*.pt
*.onnx

# --- scratch ----------------------------------------------------------------------------
:memory:.ses
*.ses
*.log
!artifacts/logs/.gitkeep
.DS_Store
